<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The framework version this suite builds against. Overridable from the environment —
         MSBuild reads environment variables as properties — so the scheduled canary can restore
         the newest published prerelease without editing this file. -->
    <HardPointTestingVersion Condition="'$(HardPointTestingVersion)' == ''">0.1.0-preview.1</HardPointTestingVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="HardPoint.Testing" Version="$(HardPointTestingVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright.MSTest.v4" Version="1.63.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="Reqnroll.MSTest" Version="3.3.4" />
  </ItemGroup>
  <ItemGroup Label="Transitive pins (security)">
    <!-- Pulled in by ExtentReports at 5.0.0, which has a critical advisory (GHSA-rxg9-xrhp-64gj). -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>
</Project>
