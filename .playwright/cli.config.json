{
  "browser": {
    "browserName": "chromium",
    "isolated": false,
    "launchOptions": {
      "headless": false,
      "slowMo": 500,
      "timeout": 30000,
      "downloadsPath": "Tests/TestResults/Downloads",
      "tracesDir": "Tests/TestResults/Traces"
    },
    "contextOptions": {
      "ignoreHTTPSErrors": true,
      "recordHarUrlFilter": "**/Product/**"
    }
  },
  "outputDir": "Tests/TestResults",
  "outputMode": "file",
  "console": {
    "level": "warning"
  },
  "timeouts": {
    "action": 30000,
    "navigation": 60000
  },
  "testIdAttribute": "data-testid",
  "codegen": "none"
}
